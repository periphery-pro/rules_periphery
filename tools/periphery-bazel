#!/usr/bin/env bash
# Run Periphery against a Bazel workspace through the generic project driver.
#
# Discovers the workspace's top-level targets, generates a hidden `scan` target,
# and invokes `periphery scan --generic-project-config` via a nested `bazel run`.
#
# Works both when invoked directly from a workspace and when invoked through
# `bazel run @rules_periphery//:periphery -- ...`, in which case Bazel
# sets BUILD_WORKSPACE_DIRECTORY.

set -euo pipefail

TOP_LEVEL_KINDS=(
    # rules_apple, iOS
    ios_app_clip
    ios_application
    ios_extension
    ios_imessage_application
    ios_imessage_extension
    ios_sticker_pack_extension
    ios_ui_test
    ios_unit_test
    # rules_apple, tvOS
    tvos_application
    tvos_extension
    tvos_ui_test
    tvos_unit_test
    # rules_apple, watchOS
    watchos_application
    watchos_extension
    watchos_ui_test
    watchos_unit_test
    # rules_apple, visionOS
    visionos_application
    visionos_ui_test
    visionos_unit_test
    # rules_apple, macOS
    macos_application
    macos_command_line_application
    macos_extension
    macos_kernel_extension
    macos_quick_look_plugin
    macos_spotlight_importer
    macos_xpc_service
    macos_ui_test
    macos_unit_test
    # rules_swift
    swift_binary
    swift_test
    swift_compiler_plugin
)

usage() {
    cat >&2 <<'EOF'
Usage: periphery-bazel [options] [-- periphery scan args...]

Options:
  --query <expr>            Bazel query for top-level targets to scan.
  --filter <pattern>        Filter pattern applied to the default target query.
  --global-indexstore <p>   Path to a global index store populated by Bazel.
  --check-visibility        Enable Bazel visibility checking for the scan target.
  --bazel-arg <arg>         Extra argument passed to `bazel run`. May be repeated.
  -h, --help                Show this help.

Arguments after `--` (or any unrecognized arguments) are forwarded to
`periphery scan`.
EOF
}

query=""
filter=""
global_indexstore=""
check_visibility="false"
bazel_args=()
periphery_args=()

while [ $# -gt 0 ]; do
    case "$1" in
        --query) query="$2"; shift 2 ;;
        --query=*) query="${1#*=}"; shift ;;
        --filter) filter="$2"; shift 2 ;;
        --filter=*) filter="${1#*=}"; shift ;;
        --global-indexstore) global_indexstore="$2"; shift 2 ;;
        --global-indexstore=*) global_indexstore="${1#*=}"; shift ;;
        --check-visibility) check_visibility="true"; shift ;;
        --bazel-arg) bazel_args+=("$2"); shift 2 ;;
        --bazel-arg=*) bazel_args+=("${1#*=}"); shift ;;
        -h|--help) usage; exit 0 ;;
        --) shift; periphery_args+=("$@"); break ;;
        *) periphery_args+=("$1"); shift ;;
    esac
done

# Fall back to environment configuration, with command-line arguments taking
# precedence. The `__`-prefixed variables are internal transport from the
# `periphery` macro, not an interface to set directly.
if [ -z "$query" ]; then query="${__PERIPHERY_QUERY:-}"; fi
if [ -z "$filter" ]; then filter="${__PERIPHERY_FILTER:-}"; fi
if [ -z "$global_indexstore" ]; then global_indexstore="${__PERIPHERY_GLOBAL_INDEXSTORE:-}"; fi
if [ "$check_visibility" != "true" ] && [ "${__PERIPHERY_CHECK_VISIBILITY:-}" = "true" ]; then
    check_visibility="true"
fi

find_workspace_root() {
    if [ -n "${BUILD_WORKSPACE_DIRECTORY:-}" ]; then
        printf '%s\n' "$BUILD_WORKSPACE_DIRECTORY"
        return 0
    fi

    local dir
    dir="$PWD"
    while [ "$dir" != "/" ]; do
        if [ -f "$dir/MODULE.bazel" ] || [ -f "$dir/WORKSPACE" ] || [ -f "$dir/WORKSPACE.bazel" ]; then
            printf '%s\n' "$dir"
            return 0
        fi
        dir="$(dirname "$dir")"
    done

    echo "error: not inside a Bazel workspace (no MODULE.bazel or WORKSPACE found)" >&2
    return 1
}

abs_path() {
    local target="$1"
    if [ -d "$target" ]; then
        (cd "$target" && pwd)
    else
        local dir base
        dir="$(dirname "$target")"
        base="$(basename "$target")"
        (cd "$dir" && printf '%s/%s\n' "$(pwd)" "$base")
    fi
}

starlark_string() {
    local s="$1"
    s="${s//\\/\\\\}"
    s="${s//\"/\\\"}"
    printf '"%s"' "$s"
}

default_query() {
    local kinds
    kinds="$(IFS='|'; printf '%s' "${TOP_LEVEL_KINDS[*]}")"
    local base="filter('^//.*', kind('(${kinds}) rule', deps(//...)))"
    if [ -n "$filter" ]; then
        printf "filter('%s', %s)" "$filter" "$base"
    else
        printf '%s' "$base"
    fi
}

if [ -n "$global_indexstore" ] && [ ! -e "$global_indexstore" ]; then
    echo "error: --global-indexstore path does not exist: $global_indexstore" >&2
    exit 1
fi

workspace_root="$(find_workspace_root)"

# Scope the generated package to the workspace so that concurrent scans of
# different workspaces don't collide. Must match the path derivation in
# extensions.bzl.
OUTPUT_DIR="/var/tmp/periphery_bazel/${workspace_root//\//_}"
GENERATED_BUILD="${OUTPUT_DIR}/BUILD.bazel"

if [ -z "$query" ]; then
    query="$(default_query)"
fi

query_output="$(cd "$workspace_root" && bazel query "$query")"

targets=()
while IFS= read -r line; do
    [ -n "$line" ] && targets+=("$line")
done <<EOF
$query_output
EOF

mkdir -p "$OUTPUT_DIR"

# Only paths and target labels are serialized into the generated BUILD;
# periphery args are forwarded at run time, so free-form user input never
# needs escaping into Starlark.
{
    printf 'load("@rules_periphery//:rules.bzl", "scan")\n\n'
    printf 'scan(\n'
    printf '    name = "scan",\n'
    printf '    testonly = True,\n'
    if [ -n "$global_indexstore" ]; then
        printf '    global_indexstore = %s,\n' "$(starlark_string "$(abs_path "$global_indexstore")")"
    fi
    printf '    deps = [\n'
    if [ ${#targets[@]} -gt 0 ]; then
        for target in "${targets[@]}"; do
            printf '        %s,\n' "$(starlark_string "@@${target}")"
        done
    fi
    printf '    ],\n'
    printf ')\n'
} >"$GENERATED_BUILD"

cd "$workspace_root"
exec bazel run \
    "--check_visibility=${check_visibility}" \
    "--ui_event_filters=-info,-debug,-warning" \
    "${bazel_args[@]+"${bazel_args[@]}"}" \
    @periphery_generated//:scan \
    -- "${periphery_args[@]+"${periphery_args[@]}"}"
